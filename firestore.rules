rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isOwner() {
      return signedIn() && role() == 'owner';
    }
    function isStaff() {
      return signedIn() && (role() == 'owner' || role() == 'cashier');
    }

    // Staff accounts and their roles. Only the owner can hand out roles;
    // staff can read their own record so the app knows which pages to show.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();
    }

    // Catalogue: readable by anyone so the storefront can list products.
    // Only the owner can change products, prices or stock levels directly.
    match /products/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Sales: any staff member can record one; only the owner can amend history.
    match /sales/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isOwner();
    }

    // Stock movements are an append-only audit trail: never edited or deleted.
    match /stock_movements/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Anything not listed above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
