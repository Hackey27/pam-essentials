rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return hasProfile() ? profile().role : null;
    }
    function activeStaff() {
      return hasProfile() && profile().active != false;
    }
    function isCashier() {
      return activeStaff() && role() == 'cashier';
    }
    function isSupervisor() {
      return activeStaff() && role() == 'supervisor';
    }
    function isAdmin() {
      return activeStaff() && (role() == 'owner' || role() == 'admin');
    }
    function isOwner() {
      return activeStaff() && role() == 'owner';
    }
    function isStaff() {
      return isCashier() || isSupervisor() || isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isOwner();
    }

    match /products/{id} {
      allow read: if isStaff() ||
        (resource.data.active == true &&
         resource.data.archived == false &&
         resource.data.sellable == true &&
         resource.data.price > 0);
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if isStaff() || resource.data.active == true;
      allow write: if isAdmin();
    }

    // Sales, order writes, stock changes and audit entries are server-authoritative.
    match /sales/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /orders/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /stock_movements/{id} {
      allow read: if isSupervisor() || isAdmin();
      allow write: if false;
    }
    match /discount_rules/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /shifts/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /admin_audit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
